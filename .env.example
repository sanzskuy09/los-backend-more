DB_NAME=nama_database
DB_USER=user_database
DB_PASSWORD=password_database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

# Token untuk endpoint /api/backup/* (wajib diisi)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BACKUP_TOKEN=isi_dengan_token_acak
